# Pad naar de frontend-repo, relatief t.o.v. deze deploy/-map.
# Lokaal (Windows): ../../../ReactProjects/airco_app_reactjs
# VPS (beide repo's naast elkaar in /opt/airco): ../../airco_app_reactjs
FRONTEND_CONTEXT=../../../ReactProjects/airco_app_reactjs

HTTP_PORT=8080
# Workbench / DBeaver: 127.0.0.1 en deze poort (3307 om lokale MySQL op 3306 vrij te laten)
MYSQL_PORT=3307

DB_NAME=aircoenwarmte
DB_USER=airco
DB_PASSWORD=vervang-db-wachtwoord
DB_ROOT_PASSWORD=vervang-root-wachtwoord

JWT_SECRET=vervang-dit-door-een-lange-willekeurige-string
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@airco.local
ADMIN_PASSWORD=changeme
